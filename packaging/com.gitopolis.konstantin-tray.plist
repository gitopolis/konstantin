<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gitopolis.konstantin-tray</string>

    <!-- Menu-bar app. Subscribes to the daemon's push channel and shows
         remaining time live in NSStatusItem. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/konstantin-tray</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <!-- Only load in GUI sessions. Prevents the agent from running in
         loginwindow/screen-sharing background contexts. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/tmp/konstantin-tray.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/konstantin-tray.err.log</string>
</dict>
</plist>
